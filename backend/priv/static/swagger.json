    "version": "1.0",
    "title": "Time Manager API"
  },
  "host": "localhost:4000",
  "definitions": {
    "WorkingTime": {
      "description": "Working time schema",
      "example": {
        "end": "2024-10-08 10:05:01",
        "id": 1,
        "start": "2024-10-08 10:05:01",
        "user_id": 1
      },
      "properties": {
        "end_": {
          "description": "Working time end time",
          "format": "utc_datetime",
          "type": "string"
        },
        "id": {
          "description": "Working time ID",
          "type": "integer"
        },
        "start": {
          "description": "Working time start time",
          "format": "utc_datetime",
          "type": "string"
        },
        "user_id": {
          "description": "User ID",
          "type": "integer"
        }
      },
      "title": "WorkingTime",
      "type": "object"
    },
    "ClockResponse": {
      "description": "Response schema for single clock",
      "properties": {
        "data": {
          "$ref": "#/definitions/Clock",
          "description": "The clock details"
        }
      },
      "title": "ClockResponse",
      "type": "object"
    },
    "NotFoundResponse": {
      "description": "Resource not found",
      "properties": {
        "reason": {
          "description": "Error reason",
          "type": "ErrorReason"
        }
      },
      "title": "NotFoundResponse",
      "type": "object"
    },
    "ClocksResponse": {
      "description": "Response schema for multiple clocks",
      "properties": {
