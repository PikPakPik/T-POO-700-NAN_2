            "$ref": "#/definitions/Clock"
          },
          "type": "array"
        }
      },
      "title": "ClocksReponse",
      "type": "object"
    },
    "Clock": {
      "description": "Clock schema",
      "example": {
        "id": 1,
        "status": false,
        "time": "2024-10-08 10:05:01",
        "user_id": 1
      },
      "properties": {
        "id": {
          "description": "Clock ID",
          "type": "integer"
        },
        "status": {
          "description": "Clock status",
          "type": "boolean"
        },
        "time": {
          "description": "Clock time",
          "format": "utc_datetime",
          "type": "string"
        },
        "user_id": {
          "description": "User ID",
          "type": "integer"
        }
      },
      "title": "Clock",
      "type": "object"
    },
    "WorkingTimeRequest": {
      "description": "Request body when creating a working time",
      "example": {
        "working_time": {
          "end": "2024-10-08 10:05:01",
          "start": "2024-10-08 10:05:01",
          "user_id": 1
        }
      },
      "properties": {
        "end_": {
          "description": "Working time end time",
          "format": "utc_datetime",
          "type": "string"
        },
        "start": {
          "description": "Working time start time",
          "format": "utc_datetime",
          "type": "string"
        },
        "user_id": {
          "description": "Associated user id",
          "type": "integer"
        }
      },
      "title": "WorkingTimeRequest",
      "type": "object"
    },
    "ErrorReason": {
      "description": "An error",
      "example": {
        "_type": "Elixir.Ecto.NoResultsError",
        "message": "expected at least one result but got none"
      },
      "properties": {
        "_type": {
          "description": "Error type",
          "type": "string"
        },
        "message": {
          "description": "Error message",
          "type": "string"
        },
        "stack": {
          "description": "Error stack trace. Only in debug mode",
