    "dayjs": "^1.11.13",
    "dayjs-with-plugins": "^1.0.4",
    "howler": "^2.2.4",
    "intro.js": "^7.2.0",
    "moment": "^2.30.1",
    "nuxt": "^3.13.0",
    "pinia": "^2.2.4",
    "postcss": "^8.4.47",
    "tailwind": "^4.0.0",
    "tailwindcss": "^3.4.13",
    "vite-plugin-vuetify": "^2.0.4",
    "vue": "^3.5.12",
    "vue-chartjs": "^5.3.1",
